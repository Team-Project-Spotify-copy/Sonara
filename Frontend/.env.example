# Client-safe configuration only. Vite inlines every VITE_* value into the public
# bundle, so never put a database password, Azure account key, JWT signing key, or the
# reCAPTCHA *server* secret here. Server-side secrets belong in .NET User Secrets.

# Backend API base URL. Must include the /api suffix.
VITE_API=http://localhost:5094/api

# Google reCAPTCHA v3 *site* key (public by design; the matching server secret is
# configured as Recaptcha:SecretKey in User Secrets).
VITE_RECAPTCHA_SITE_KEY=

# Serve hard-coded mock data for the home feed and library instead of calling the API.
# NOTE: the flag is opt-out - endpoints.js treats anything other than the string
# "false" as enabled, so an unset variable means mocks are ON.
VITE_USE_MOCKS=false

# ---------------------------------------------------------------------------
# scripts/import-music.mjs only. These are NOT VITE_* variables: they are read
# by the Node importer and are never inlined into the browser bundle. Load them
# with Node's own flag so they stay out of the repository:
#
#   node --env-file=.env scripts/import-music.mjs --source jamendo --limit 500
# ---------------------------------------------------------------------------

# Jamendo application client id - https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

# API base for the importer (defaults to http://localhost:5094/api).
SONARA_API=http://localhost:5094/api

# An Admin (or Moderator) account for POST /api/admin/*. Supply either a token
# or the e-mail/password pair; the importer logs in when no token is given.
SONARA_ADMIN_TOKEN=
SONARA_ADMIN_EMAIL=
SONARA_ADMIN_PASSWORD=
