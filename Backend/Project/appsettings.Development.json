{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Vite has no fixed port configured, so it serves on 5173 and falls back to
  // 5174 when 5173 is already taken. Both are listed explicitly: the policy uses
  // AllowCredentials() for the refresh-token cookie, which forbids AllowAnyOrigin.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  }
}
