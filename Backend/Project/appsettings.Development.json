{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Vite has no fixed port configured, so it serves on 5173 and walks upwards
  // (5174, 5175, ...) whenever the previous port is already taken. Every port it
  // can land on is listed explicitly: the policy uses AllowCredentials() for the
  // refresh-token cookie, which forbids AllowAnyOrigin.
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175",
      "http://localhost:5176",
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  }
}
